// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Person {
  id         String   @id @default(cuid())
  name       String
  birthday   DateTime
  cakeBought Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ZulipSettings {
  id       String  @id @default("singleton")
  // Base URL of the Zulip server, e.g. "https://your-org.zulipchat.com"
  siteUrl  String  @default("")
  // Email address of the incoming-webhook bot used to send messages.
  botEmail String  @default("")
  // NOTE: stored in plaintext. The whole app requires a Keycloak login,
  // but treat this key as sensitive (it can post as the bot) regardless.
  apiKey   String  @default("")
  stream   String  @default("")
  topic    String  @default("Birthdays")
  enabled  Boolean @default(false)
}
